# =============================================================================
# /etc/config/network — Tenda BE12 Pro 预置网络配置
# -----------------------------------------------------------------------------
# 来源：实机 192.168.100.254 uci 导出（2026-11-17 采集），已脱敏：
#   宽带账号 / 密码一律留空，构建时由 preset/scripts/inject-secrets.sh
#   从本地 secrets.env 或 CI Secrets 注入。
#
# 接口映射（依据 board.json）：
#   LAN = lan4 + lan5 + eth1（br-lan）
#   WAN1 = eth2（2.5G，电信光猫路由模式 → DHCP）
#   WAN2 = lan3（1G，移动光猫桥接 → PPPoE 直拨）
# =============================================================================

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.100.254'
	option netmask '255.255.255.0'
	option ip6assign '60'
	list dns '223.5.5.5'
	list dns '119.29.29.29'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan4'
	list ports 'lan5'
	list ports 'eth1'
	option stp '1'
	option igmp_snooping '1'

# ---- WAN1：电信 1000M（eth2 / DHCP）----
config interface 'wan'
	option device 'eth2'
	option proto 'dhcp'
	option metric '10'

# ---- WAN2：移动 300M（lan3 / PPPoE）----
# 凭据由注入脚本填充；手工填写命令：
#   uci set network.wan2.username='账号'
#   uci set network.wan2.password='密码'
#   uci commit network && reload_config      # 切勿用 network restart，见 README §8
config interface 'wan2'
	option device 'lan3'
	option proto 'pppoe'
	option metric '20'
	option ipv6 '0'
	option username ''
	option password ''

config pppoless 'wan2_lease'
	list interface 'wan2'

# ---- IPv6：保持关闭（双 WAN 场景复杂度高，见 README §5.5）----

# ---- Tailscale 虚拟接口（luci-app-tailscale-community 使用）----
config interface 'tailscale'
	option proto 'none'
	option device 'tailscale0'
	option metric '0'

config device
	option name 'lan3'
	option type 'ethernet'

config device
	option name 'lan4'
	option type 'ethernet'

config device
	option name 'lan5'
	option type 'ethernet'
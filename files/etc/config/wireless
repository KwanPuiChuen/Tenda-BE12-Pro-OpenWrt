# Tenda BE12 Pro 无线预置（与实机 2026-11-17 一致）
# =============================================================================
# ⚠️ /etc/config/wireless 不在 rootfs 中，由 /sbin/wifi config 从 board.json 生成；
#    必须用「带正确段类型」的完整文件预置，否则 uci set 会造出伪段且静默失效
#    （历史上曾因此以开放网络 OpenWrt 上线，见 AGENTS.md 坑 10）。
#
# ⚠️ WiFi 密码不写在公开仓库：下面 key 为占位符，构建时由
#    preset/scripts/inject-secrets.sh 用 secrets.env 的 WIFI_PSK_2G/5G 替换。
#    直接编译公开版会得到 CHANGE_ME_WIFI_PSK，首启脚本会告警提醒修改。
# =============================================================================

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'soc/11280000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
	option radio '0'
	option band '2g'
	option country 'CN'
	option channel '1'
	option htmode 'EHT20'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'ASUS'
	option encryption 'psk2'
	option key 'CHANGE_ME_WIFI_PSK'
	option disabled '0'

# ---- 5G：实机使用 country AU + EHT160（160MHz 需 36-64 连续信道）----
# ⚠️ AU 监管域仅为开出 160MHz；国内使用属超范围，功率/DFS 行为不受 CN 约束。
#    如需合规，改 country 'CN' + htmode 'EHT80'（36-64 内可用）。
config wifi-device 'radio1'
	option type 'mac80211'
	option path 'soc/11280000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
	option radio '1'
	option band '5g'
	option channel '36'
	option htmode 'EHT160'
	option country 'AU'
	option disabled '0'
	option cell_density '2'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'ASUS'
	option encryption 'psk2'
	option key 'CHANGE_ME_WIFI_PSK'
	option disabled '0'
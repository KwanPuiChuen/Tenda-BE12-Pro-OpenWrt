# =============================================================================
# preset/secrets.env.example — 本地凭据模板
# -----------------------------------------------------------------------------
# 用法：
#   cp preset/secrets.env.example preset/secrets.env
#   vi preset/secrets.env          # 填入真实值
#   ./scripts/build.sh             # 构建时会自动注入
#
# ⚠️ preset/secrets.env 已在 .gitignore 中，**永远不要**提交或贴进 issue。
# ⚠️ 公开仓库 / CI 构建：不提供本文件即产出「无凭据版」固件，
#    刷完后 WiFi 密码为占位符、PPPoE 为空，需在 LuCI 内手工填写。
# =============================================================================

# ---- PPPoE（WAN2 / 移动）----
PPPOE_USER=
PPPOE_PASS=

# ---- WiFi（2.4G 与 5G 共用）----
WIFI_SSID=ASUS
WIFI_PSK=

# ---- 网络唤醒目标 MAC（LuCI → 网络 → 网络唤醒）----
WOL_MAC=

# ---- root 密码：二选一 ----
# 推荐直接给 hash（路由器上 `openssl passwd -5 '你的密码'` 生成）
ROOT_PASSWORD_HASH=
# 或给明文，首启脚本会用 openssl 现场生成 hash（明文只在 /usr/share 短暂停留）
ROOT_PASSWORD=